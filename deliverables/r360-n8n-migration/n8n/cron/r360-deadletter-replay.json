      ],
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "JUyr1xCnPHSkU1tm",
          "name": "[RH] UAT"
        }
      },
      "notes": "SOQL: SELECT Id, Idempotency_Hash__c, Source__c, Payload__c, Retry_Count__c, External_Submission_Id__c FROM Lead_Inbound_Log__c WHERE Status__c = 'failed' AND Retry_Count__c < 5 AND Received_At__c >= LAST_N_HOURS:24 LIMIT 50"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/r360/{{ $json.Source__c === 'wpform_29710' ? 'contact-form' : ($json.Source__c === 'wpform_29712' ? 'watch-video' : ($json.Source__c === 'wpform_29714' ? 'get-demo' : ($json.Source__c === 'bot_r360' ? 'bot' : ($json.Source__c === 'webhook_pre_discovery' ? 'pre-discovery' : 'faq')))) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.parse($json.Payload__c) }}",
        "options": {}
      },
      "id": "dlrp-0003-4000-8000-000000000003",
      "name": "HTTP: Replay payload to receiver",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        320
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://por--uat.sandbox.my.salesforce.com/services/data/v66.0/sobjects/Lead_Inbound_Log__c/{{ $json.Id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "salesforceOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"Retry_Count__c\": ($json.Retry_Count__c || 0) + 1\n}",
        "options": {}
      },
      "id": "dlrp-0004-4000-8000-000000000004",
      "name": "SF Update: increment Retry_Count__c",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        320
      ],
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "JUyr1xCnPHSkU1tm",
          "name": "[RH] UAT"
        }
      },
      "notes": "Retry_Count__c++ on every replay attempt. When = 5, stop retrying and rely on sub-error-handler escalation."
