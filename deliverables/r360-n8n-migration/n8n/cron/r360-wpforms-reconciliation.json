{
  "updatedAt": "2026-05-17T17:03:50.432Z",
  "createdAt": "2026-05-10T19:09:50.743Z",
  "id": "T1XKVSPaLzAuUh0l",
  "name": "R360 Cron: WPForms DB Reconciliation (every 10 min, via SSH)",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      },
      "id": "rec-1",
      "name": "Schedule: every 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "resource": "command",
        "command": "MYSQL_PWD=ZO8i4xKtqmyoe7OLwmGG mysql -h 127.0.0.1 -P 3306 -u record360 wp_record360 --batch --skip-column-names <<< $(echo  | base64 -d)",
        "cwd": "/tmp",
        "options": {},
        "authentication": "privateKey"
      },
      "id": "rec-2",
      "name": "SSH: Pull last-30min WPForms entries",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        460,
        320
      ],
      "credentials": {
        "sshPrivateKey": {
          "id": "upHoqgOVbETJsqE5",
          "name": "R360 WPE SSH (sshPrivateKey, ed25519)"
        }
      },
      "notes": "Runs MySQL query via SSH command (bypasses n8n's MySQL+SSH-tunnel bug). Returns TSV stdout: entry_id\\tform_id\\tdate\\tfields_json"
    },
    {
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst stdout = $input.first().json.stdout || '';\nif (!stdout.trim()) return [];\nconst lines = stdout.split('\\n').filter(l => l.trim());\nreturn lines.map(line => {\n  const parts = line.split('\\t');\n  const entry_id = parts[0], form_id = parts[1], date = parts[2], fields_raw = parts[3];\n  const hash = crypto.createHash('sha256').update(form_id + ':' + entry_id).digest('hex');\n  let fields = {};\n  try { fields = JSON.parse(fields_raw || '{}'); } catch (e) {}\n  return {\n    json: {\n      entry_id: String(entry_id),\n      form_id: String(form_id),\n      date,\n      fields,\n      Idempotency_Hash__c: hash,\n      source_form: 'wpform_' + form_id,\n    }\n  };\n});\n"
      },
      "id": "rec-3",
      "name": "Code: Parse TSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        320
      ],
      "notes": "Parses TSV stdout, computes idempotency hash per row, emits one item per WPForms entry"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nif (!items.length) {\n  return [{ json: { soql: '', has_items: false, hashes: [] } }];\n}\nconst hashes = items.map(i => i.json.Idempotency_Hash__c);\nconst inList = hashes.map(h => \"'\" + h + \"'\").join(',');\nconst soql = \"SELECT Idempotency_Hash__c FROM Lead_Inbound_Log__c WHERE Idempotency_Hash__c IN (\" + inList + \")\";\nreturn [{ json: { soql, has_items: true, hashes, count: hashes.length } }];\n"
      },
      "id": "rec-build-soql",
      "name": "Code: Build SOQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        320
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://por--uat.sandbox.my.salesforce.com/services/data/v66.0/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "salesforceOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.soql }}"
            }
          ]
        },
        "options": {}
      },
      "id": "rec-4-http",
      "name": "SF HTTP: query existing hashes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        320
      ],
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "JUyr1xCnPHSkU1tm",
          "name": "[RH] UAT"
        }
      },
      "notes": "Direct SF REST query — replaces the customObject search node which doesn't support IN clauses cleanly"
    },
    {
      "parameters": {
        "jsCode": "\nconst wpItems = $('Code: Parse TSV').all();\nconst sfRecords = $input.first().json.records || [];\nconst sfHashes = new Set(sfRecords.map(r => r.Idempotency_Hash__c));\nconst missing = wpItems.filter(i => !sfHashes.has(i.json.Idempotency_Hash__c));\nreturn missing.map(i => ({ json: i.json }));\n"
      },
      "id": "rec-5",
      "name": "Code: Diff (missing from SF)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-missing",
              "leftValue": "={{ $items().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      },
      "id": "rec-6",
      "name": "IF: missing > 0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://n8nweb.ec-ops.org/webhook/r360/{{ $json.source_form === 'wpform_29710' ? 'contact-form' : ($json.source_form === 'wpform_29712' ? 'watch-video' : 'get-demo') }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"entry_id\": \"{{ $json.entry_id }}\",\n  \"form_id\": \"{{ $json.form_id }}\",\n  \"fields\": {{ JSON.stringify($json.fields) }},\n  \"_replay\": true,\n  \"_replay_source\": \"ssh_db_reconciliation\"\n}",
        "options": {}
      },
      "id": "rec-7",
      "name": "HTTP: Replay missing to receiver",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        240
      ],
      "notes": "Receiver computes the same hash, sees existing Inbound_Log row (real-time delivery wins) OR creates a new one with Status='replayed'"
    }
  ],
  "connections": {
    "Schedule: every 10 min": {
