        "jsCode": "// Compute idempotency hash for bot conversation\nconst crypto = require('crypto');\nconst entryId = String($json.wpformsEntryId || '');\nconst hash = crypto.createHash('sha256').update(`bot_r360:${entryId}`).digest('hex');\nreturn [{ json: { ...$json, Idempotency_Hash__c: hash, Received_At__c: new Date().toISOString(), Payload__c: JSON.stringify($json).substring(0, 32000) } }];"
