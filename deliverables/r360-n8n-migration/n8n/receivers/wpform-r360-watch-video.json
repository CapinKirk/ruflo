      "parameters": {
        "jsCode": "// WPForm 29712 — email + click IDs ONLY (no name/company/phone)\nconst raw = $json.body || $json;\nconst crypto = require('crypto');\nconst entryId = String(raw.entry_id || raw.entry?.entry_id || raw.id || '');\nconst hash = crypto.createHash('sha256').update(`29712:${entryId}`).digest('hex');\nreturn [{ json: {\n  source: 'wpform_29712',\n  WPFormName: 'WatchVideo',\n  wpformsEntryId: entryId,\n  Idempotency_Hash__c: hash,\n  Received_At__c: new Date().toISOString(),\n  Payload__c: JSON.stringify(raw).substring(0, 32000),\n  BusinessEmail: raw.fields?.['7']  || raw.field7  || '',\n  // no name/company/phone/UTMs — see build plan §4.1 critical observation\n  gclid:   raw.fields?.['10'] || raw.field10 || '',\n  fbc:     raw.fields?.['11'] || raw.field11 || '',\n  fbp:     raw.fields?.['12'] || raw.field12 || '',\n  msclkid: raw.fields?.['13'] || raw.field13 || ''\n} }];"
      },
