      "parameters": {
        "jsCode": "// WPForm 29714 — email + click IDs ONLY (note: fbp/msclkid offset by +1 vs 29712)\nconst raw = $json.body || $json;\nconst crypto = require('crypto');\nconst entryId = String(raw.entry_id || raw.entry?.entry_id || raw.id || '');\nconst hash = crypto.createHash('sha256').update(`29714:${entryId}`).digest('hex');\nreturn [{ json: {\n  source: 'wpform_29714',\n  WPFormName: 'GetADemo',\n  wpformsEntryId: entryId,\n  Idempotency_Hash__c: hash,\n  Received_At__c: new Date().toISOString(),\n  Payload__c: JSON.stringify(raw).substring(0, 32000),\n  BusinessEmail: raw.fields?.['7']  || raw.field7  || '',\n  gclid:   raw.fields?.['10'] || raw.field10 || '',\n  fbc:     raw.fields?.['11'] || raw.field11 || '',\n  fbp:     raw.fields?.['13'] || raw.field13 || '',  // +1 vs 29712\n  msclkid: raw.fields?.['14'] || raw.field14 || ''   // +1 vs 29712\n} }];"
      },
